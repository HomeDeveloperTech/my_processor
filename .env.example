# Copy this file to `.env` and adjust values for your environment
# These variables will be auto-loaded by scripts/start-linux.sh and scripts/start-ubuntu.sh

# Spring profile to use (dev|prod|test)
SPRING_PROFILES_ACTIVE=prod

# Server port
SERVER_PORT=8080

# Database (Oracle) connection settings
SPRING_DATASOURCE_URL=jdbc:oracle:thin:@//your-host:1521/ORCLCDB
SPRING_DATASOURCE_USERNAME=your_user
SPRING_DATASOURCE_PASSWORD=your_password

# Hibernate / JPA tuning (optional)
SPRING_JPA_HIBERNATE_DDL_AUTO=none
SPRING_JPA_SHOW_SQL=false

# JVM options (example: memory, GC)
JAVA_OPTS=-Xms256m -Xmx512m
